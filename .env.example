# Archil (https://console.archil.com)
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1

# Passed to each agent process (not stored on the sandbox)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# From `python -m archil_temporal.build_image <your image>`
ARCHIL_IMAGE_ID=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Optional tuning
# AGENT_VCPUS=2
# AGENT_MEM_MIB=4096
# SANDBOX_MAX_TTL_SECONDS=21600
# SANDBOX_ORPHAN_TTL_SECONDS=900
# MAX_CONCURRENT_ACTIVITIES=500
