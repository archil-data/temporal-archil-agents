# Archil (https://console.archil.com)
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-west-2

# From `python -m archil_temporal.build_image <your image>`
ARCHIL_IMAGE_ID=

# Temporal. For Temporal Cloud, use your namespace's endpoint and an API key
# (which turns on TLS). Each sandbox's worker connects to the same Temporal.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# TEMPORAL_API_KEY=

# Added to the agents' Anthropic API requests by Archil's egress proxy, outside
# the sandbox; the agent only sees a placeholder (see RESTRICT_EGRESS below).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# Agents can reach only Temporal, the Anthropic API, and their URL's host.
# Needs a paid Archil plan; with RESTRICT_EGRESS=false the key is passed into
# the sandbox.
# RESTRICT_EGRESS=true
# AGENT_ALLOWED_HOSTS=pypi.org,files.pythonhosted.org

# Optional tuning
# SANDBOX_MAX_TTL_SECONDS=21600
# MAX_CONCURRENT_ACTIVITIES=100
